<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the encrypted vault (files/datastore, keyset prefs), the app database
     and Flutter's documents directory are excluded from cloud backup and device transfer. The
     Keystore master key cannot move to another device anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="app_flutter" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="app_flutter" />
    </device-transfer>
</data-extraction-rules>
